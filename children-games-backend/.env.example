# 服务器配置
PORT=3000
NODE_ENV=development

# Sentry 错误监控（留空则不上报，生产环境建议配置）
SENTRY_DSN=

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=children_games
DB_USER=root
DB_PASSWORD=your_password

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 密钥 (生产环境必须使用至少 32 字符的随机字符串)
JWT_SECRET=your_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# CORS 白名单 (生产环境必须配置，逗号分隔，不允许通配符)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3002

# 微信小程序配置（后续需要）
WX_APPID=
WX_SECRET=
ADMIN_PASSWORD=change_me
